SPORTS_SUPERMODEL_TIMEZONE=America/New_York
SPORTS_SUPERMODEL_ODDS_API_KEY=
SPORTS_SUPERMODEL_ODDS_BOOKMAKERS=draftkings,fanduel,hardrockbet

# Storage: local is the default. Hosted deployments can enable PostgreSQL + S3.
SPORTS_SUPERMODEL_STORAGE_BACKEND=local
DATABASE_URL=
SPORTS_SUPERMODEL_OBJECT_BACKEND=local
SPORTS_SUPERMODEL_OBJECT_ROOT=runtime/objects
SPORTS_SUPERMODEL_S3_BUCKET=
SPORTS_SUPERMODEL_S3_PREFIX=sports-supermodel
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
SPORTS_SUPERMODEL_S3_ENDPOINT_URL=
SPORTS_SUPERMODEL_S3_FORCE_PATH_STYLE=0

# Hosted service and security controls
SPORTS_SUPERMODEL_ENV=development
SPORTS_SUPERMODEL_REQUIRE_SHARED_STORAGE=0
SPORTS_SUPERMODEL_REQUIRE_HTTPS=0
SPORTS_SUPERMODEL_TRUST_PROXY_HEADERS=0
SPORTS_SUPERMODEL_ADMIN_TOKEN=
SPORTS_SUPERMODEL_RATE_LIMIT=120
SPORTS_SUPERMODEL_RATE_LIMIT_WINDOW=60
SPORTS_SUPERMODEL_ALERT_WEBHOOK=
SPORTS_SUPERMODEL_API_ACCESS_LOG=1
SPORTS_SUPERMODEL_ODDS_INTERVAL_SECONDS=600
SPORTS_SUPERMODEL_SETTLEMENT_INTERVAL_SECONDS=1800

# Public deployment is deliberately dormant by default. These variables are only
# set when the user explicitly approves a future hosted launch.
SPORTS_SUPERMODEL_PUBLIC_DEPLOYMENT_ENABLED=0
SPORTS_SUPERMODEL_PUBLIC_DEPLOYMENT_ACK=
