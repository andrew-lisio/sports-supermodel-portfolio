SPORTS_SUPERMODEL_OBJECT_ROOT=runtime/objects
SPORTS_SUPERMODEL_S3_BUCKET=
SPORTS_SUPERMODEL_S3_PREFIX=sports-supermodel
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
SPORTS_SUPERMODEL_S3_ENDPOINT_URL=
SPORTS_SUPERMODEL_S3_FORCE_PATH_STYLE=0
